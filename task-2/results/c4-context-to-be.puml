@startuml Task2_C4_Context_ToBe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

title Task 2 — C4 System Context To Be: B2B price-list export

Person(b2b, "B2B-клиент", "Получает ежедневный кастомный прайс-лист")

System(priceListSystem, "Модуль формирования B2B-прайс-листов", "Ежедневно в 06:00 формирует индивидуальные CSV/XLS-прайс-листы")

System_Ext(shop, "Онлайн-магазин", "Предоставляет актуальные данные товаров, категорий, клиентов и индивидуальных цен из PostgreSQL")
System_Ext(storage, "Объектное хранилище", "Надёжно хранит сформированные CSV/XLS-файлы и предоставляет их для выдачи клиентам")

Rel(priceListSystem, shop, "Читает актуальные данные для формирования прайс-листов", "PostgreSQL, read-only")
Rel(priceListSystem, storage, "Публикует готовые прайс-листы", "CSV/XLS")
Rel(b2b, priceListSystem, "Получает ссылку/доступ к своему прайс-листу")
Rel(priceListSystem, b2b, "Предоставляет сформированный прайс-лист", "download / signed URL / B2B API")

SHOW_LEGEND()
@enduml
