@startuml Task2_C4_Context_ToBe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

title Задание 2 — C4: контекстная диаграмма целевого состояния для B2B-прайс-листов

Person(b2b, "B2B-клиент", "Получает ежедневный индивидуальный прайс-лист")

System(priceListSystem, "Модуль формирования B2B-прайс-листов", "Ежедневно в 06:00 формирует индивидуальные CSV/XLS-прайс-листы")

System_Ext(shop, "Онлайн-магазин", "Предоставляет актуальные данные товаров, категорий, клиентов и индивидуальных цен из PostgreSQL")
System_Ext(storage, "Объектное хранилище", "Надёжно хранит сформированные CSV/XLS-файлы и предоставляет их клиентам")

Rel(priceListSystem, shop, "Читает актуальные данные для формирования прайс-листов", "PostgreSQL, только чтение")
Rel(priceListSystem, storage, "Публикует готовые прайс-листы", "CSV/XLS")
Rel(b2b, priceListSystem, "Запрашивает доступ к своему прайс-листу")
Rel(priceListSystem, b2b, "Предоставляет сформированный прайс-лист", "ссылка / подписанная ссылка / B2B API")

SHOW_LEGEND()
@enduml
