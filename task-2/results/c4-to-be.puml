@startuml Task2_C4_Container_ToBe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title Task 2 — C4 Container To Be: ежедневная выгрузка B2B-прайс-листов

Person(b2b, "B2B-клиент", "Получает сформированный прайс-лист")

System_Ext(shop, "Онлайн-магазин", "Источник актуальных данных")
ContainerDb_Ext(priceDb, "БД прайс-листов", "PostgreSQL", "products, categories, clients, client_prices")
System_Ext(objectStorage, "Объектное хранилище", "GCS/S3-compatible", "Хранит сформированные CSV/XLS-файлы")

System_Boundary(priceListSystem, "Модуль формирования B2B-прайс-листов") {
    Container(exporter, "Price List Exporter", "Container, Kubernetes CronJob → Job → Pod", "В 06:00 читает данные, формирует отдельные CSV/XLS для клиентов и публикует их атомарно")
}

Rel(shop, priceDb, "Хранит и обновляет данные", "PostgreSQL")
Rel(exporter, priceDb, "Читает данные потоковым SQL/JOIN", "PostgreSQL, read-only")
Rel(exporter, objectStorage, "Публикует готовые файлы", "CSV/XLS")
Rel(b2b, objectStorage, "Скачивает свой прайс-лист", "download / signed URL")

SHOW_LEGEND()
@enduml
