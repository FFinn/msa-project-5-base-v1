@startuml Task5_C4_Observability
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title Задание 5 — TradeWare: целевая архитектура с наблюдаемостью

Person(employee, "Сотрудник склада", "Загружает CSV и получает статус обработки")
Person(oncall, "Дежурный инженер", "Получает оповещения и расследует инциденты")

System_Boundary(tradeware, "Платформа TradeWare в Google Cloud") {
    Container(frontend, "ERP-интерфейс", "Angular", "Загрузка отчёта и просмотр статуса")
    Container(monolith, "Существующий бэкенд", "Java 11 / WildFly", "Текущая ERP-бизнес-логика; постепенно декомпозируется")
    Container(intake, "Сервис приёма отчётов", "Spring Boot + Micrometer + OpenTelemetry", "Быстрая валидация, регистрация файла и API статуса")
    Container(queue, "Очередь обработки отчётов", "Google Cloud Pub/Sub / Apache Kafka", "Буферизует всплески загрузок и сглаживает нагрузку")
    Container(batch, "Обработчик пакетных заданий", "Spring Boot + Spring Batch + Micrometer + OpenTelemetry", "Пакетная обработка: валидация → обогащение → массовая запись")
    ContainerDb(statusDb, "Хранилище статусов импорта", "PostgreSQL / Cloud SQL", "Прикладной статус импорта по file_id: ACCEPTED/PROCESSING/COMPLETED/FAILED")
    ContainerDb(jobRepo, "Хранилище состояния Spring Batch", "PostgreSQL / Cloud SQL", "Техническое состояние JobExecution, StepExecution и контрольных точек")
    ContainerDb(referenceDb, "БД справочных данных", "PostgreSQL / Cloud SQL", "Характеристики товаров, промоакции и справочники")
    ContainerDb(nomenclatureDb, "БД номенклатуры", "PostgreSQL / Cloud SQL", "Актуальные остатки и данные по товарам")
    Container(gcs, "Файловое хранилище", "Google Cloud Storage", "Исходные CSV и отчёты об ошибках")
}

System_Boundary(obs, "Контур наблюдаемости") {
    Container(prometheus, "Prometheus", "База временных рядов", "Собирает метрики, выполняет PromQL и проверяет правила оповещений")
    Container(grafana, "Grafana", "Визуализация", "Панели мониторинга и анализ метрик")
    Container(alertmanager, "Alertmanager", "Маршрутизация оповещений", "Группирует и направляет активные и закрытые оповещения")
    Container(filebeat, "Filebeat", "Агент доставки логов", "Собирает контейнерные и файловые логи")
    Container(logstash, "Logstash", "Конвейер обработки логов", "Разбирает, нормализует и обогащает события")
    ContainerDb(elastic, "Elasticsearch", "Поисковое хранилище документов", "Хранит индексы логов и управляет их жизненным циклом")
    Container(kibana, "Kibana", "Анализ логов", "Поиск, фильтрация и панели по логам")
    Container(otel, "OpenTelemetry Collector", "Конвейер телеметрии", "Принимает, обрабатывает и передаёт трассировки")
    Container(jaeger, "Jaeger", "Распределённая трассировка", "Хранение, поиск и визуализация трассировок")
}

System_Ext(notifications, "Каналы оповещения", "Telegram / Slack / Email / PagerDuty")

Rel(employee, frontend, "Загружает CSV и смотрит статус", "HTTPS")
Rel(frontend, intake, "Загрузка отчёта и запрос статуса", "REST/HTTP")
Rel(frontend, monolith, "Остальные ERP-операции", "REST/HTTP")
Rel(intake, gcs, "Сохраняет исходный CSV")
Rel(intake, statusDb, "Создаёт запись ACCEPTED и читает статус", "SQL")
Rel(intake, queue, "Публикует событие ReportUploaded(file_id)")
Rel(batch, queue, "Получает задание")
Rel(batch, statusDb, "Обновляет PROCESSING/COMPLETED/FAILED", "SQL")
Rel(batch, gcs, "Читает CSV и пишет отчёт об ошибках")
Rel(batch, referenceDb, "Читает данные для обогащения", "SQL")
Rel(batch, nomenclatureDb, "Выполняет массовую запись порциями", "SQL")
Rel(batch, jobRepo, "Сохраняет состояние и контрольные точки", "JDBC")
Rel(batch, queue, "Публикует ReportProcessed/ReportFailed")

Rel(prometheus, intake, "Забирает /actuator/prometheus", "HTTP pull")
Rel(prometheus, batch, "Забирает /actuator/prometheus", "HTTP pull")
Rel(prometheus, queue, "Собирает метрики очереди через экспортёр")
Rel(prometheus, statusDb, "Собирает метрики БД через экспортёр")
Rel(prometheus, jobRepo, "Собирает метрики БД через экспортёр")
Rel(prometheus, referenceDb, "Собирает метрики БД через экспортёр")
Rel(prometheus, nomenclatureDb, "Собирает метрики БД через экспортёр")
Rel(grafana, prometheus, "Выполняет запросы PromQL")
Rel(prometheus, alertmanager, "Передаёт активные и закрытые оповещения")
Rel(alertmanager, notifications, "Направляет уведомления")
Rel(oncall, grafana, "Анализирует метрики")

Rel(monolith, filebeat, "Файловые логи и stdout WildFly")
Rel(intake, filebeat, "JSON-логи из stdout")
Rel(batch, filebeat, "JSON-логи из stdout")
Rel(filebeat, logstash, "Передаёт логи")
Rel(logstash, elastic, "Индексирует нормализованные события")
Rel(kibana, elastic, "Ищет и агрегирует данные")
Rel(oncall, kibana, "Ищет события по file_id/trace_id")

Rel(intake, otel, "Передаёт трассировки и контекст по OTLP")
Rel(batch, otel, "Передаёт трассировки и контекст по OTLP")
Rel(otel, jaeger, "Передаёт спаны")
Rel(oncall, jaeger, "Ищет медленные и ошибочные участки")

SHOW_LEGEND()
@enduml
